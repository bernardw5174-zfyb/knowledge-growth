.DS_Store
.workbuddy/
__pycache__/
*.pyc

# 根目录个人内容兜底（AGENTS.md「备份纪律」：备份必须落 vault/<领域>/00-raw/）
# push main 会触发 .github/workflows/mirror.yml 强制镜像到公开 Gitee——根目录个人文件=对外泄露
/*-原件备份-*
/*-备份-*
/备份/
/*-导出-*

# User-created personal knowledge and attachments stay local.
vault/*/00-raw/*
!vault/*/00-raw/README.md
vault/*/01-知识/_drafts/*
!vault/*/01-知识/_drafts/README.md
vault/*/01-知识/*.md
!vault/*/01-知识/README.md
vault/*/02-框架/*.md
!vault/*/02-框架/README.md
vault/*/03-实战/*.md
!vault/*/03-实战/README.md
vault/*/04-复盘/*.md
!vault/*/04-复盘/README.md

# Mounted vertical packages are separate git clones — never tracked by Core.
vault/_packages/
